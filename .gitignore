# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Build outputs
.next/
out/
dist/
build/

# Generated images (keep structure, ignore contents)
outputs/*
!outputs/.gitkeep

# Large ML models fetched on first run (face_parse_service downloads these to
# backend/models and degrades gracefully if the fetch fails). Kept out of git
# because 20MB of binaries in history cannot be undone, whereas a re-download
# can. The small legacy detector models predate this and stay tracked.
backend/models/selfie_multiclass_256x256.tflite
backend/models/face_landmarker.task

# Environment
.env
.env.local
.env*.local

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# rembg model cache
.u2net/

# Runtime data (generated at runtime, not source-controlled)
backend/data/stats.json
backend/data/archived.json
backend/data/feature_flags.json
# Gallery index DB — live per-deployment data; never source-controlled.
# (SQLite WAL mode also produces -wal/-shm sidecars; ignore those too so
#  `git clean` in the deploy never corrupts an active DB.)
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm

# Stray phone screenshots accidentally committed
IMG_*.PNG
IMG_*.png

# Markdown files (noisy docs)
*.md
!README.md
