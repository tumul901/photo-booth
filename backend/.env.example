# ========================================
# Photobooth Backend Configuration
# ========================================
# Copy this file to .env and fill in your values.
# All settings have sensible defaults for local development.

# --- General ---
# BASE_URL=http://localhost:8000
# FRONTEND_URL=http://localhost:3000

# --- Storage Provider ---
# "local" = save to outputs/ directory (default, for development)
# "s3"    = save to AWS S3 bucket (for production)
STORAGE_PROVIDER=local

# --- fal.ai cloud background removal (optional) ---
# Needed only by the cloud_birefnet_* profiles in the admin Feature Flags panel.
# Without a key those profiles silently fall back to the local model.
# Get one at https://fal.ai/dashboard/keys — format is "<key_id>:<key_secret>".
FAL_KEY=
# FAL_TIMEOUT_S=12

# --- Self-hosted BiRefNet GPU box (optional) ---
# Needed only by the "selfhost_birefnet" profile in the admin Feature Flags panel.
# Without a URL that profile silently falls back to the local model.
#
# Use the LOAD BALANCER address, never an instance IP: the boxes bind their
# container to loopback and sit behind the NLB for TLS, and pointing at one
# instance means a second box can never take any traffic.
BG_SERVICE_URL=
# Read timeout. Kept under the ~26s a freshly restarted box spends on its first
# inference, so photos captured during a reboot fall back to the local model
# quickly instead of making the guest wait it out.
# BG_SERVICE_TIMEOUT_S=15
# BG_SERVICE_CONNECT_TIMEOUT_S=5
# Compact JPEG+PNG response body. Set false only if a proxy mangles it.
# BG_SERVICE_SPLIT=true

# --- AWS S3 (required when STORAGE_PROVIDER=s3) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=ap-south-1
# AWS_S3_CDN_URL=https://your-cloudfront-distribution.cloudfront.net
